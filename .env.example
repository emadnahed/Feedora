# Server Configuration
PORT=3000
NODE_ENV=development

# GitHub Webhook Configuration
# Generate a secure secret for webhook signature verification
# In production, use a strong random string
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# MongoDB Configuration
# Connection URI for MongoDB (supports replica sets and authentication)
MONGODB_URI=mongodb://localhost:27017/feedora
MONGODB_POOL_SIZE=10

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379
REDIS_TTL=300

# Rate Limiting Configuration
# Window size in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Maximum API requests per window
RATE_LIMIT_API_MAX=100
# Maximum webhook requests per window
RATE_LIMIT_WEBHOOK_MAX=1000
# Maximum feed requests per window
RATE_LIMIT_FEED_MAX=60

# Feature Flags
# Set to 'false' to disable webhook signature validation (not recommended for production)
VALIDATE_SIGNATURE=true
# Set to 'false' to disable rate limiting
RATE_LIMITING=true
